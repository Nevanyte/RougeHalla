{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Read-only source contract inventory, not an implemented parser or a new server contract. Unknown future object properties remain safe. Numeric maximum reflects actual Rust i64; strict lexical integer decode is proposed separately.",
  "$defs": {
    "Profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{2,16}$"
        },
        "gv": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gvLifetime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gvByMonth": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "wins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "draws": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "deaths": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "kills": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "runs",
            "wins",
            "draws",
            "deaths",
            "kills"
          ],
          "additionalProperties": true
        },
        "cosmetics": {
          "type": "object",
          "properties": {
            "owned": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "equipped": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "owned",
            "equipped"
          ],
          "additionalProperties": true
        },
        "achievements": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "progress": {
          "type": "object",
          "properties": {
            "qualifiedWins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "bountyRuns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "bestRunKills": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "winsByFaction": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            },
            "winsByWeapon": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            }
          },
          "required": [
            "qualifiedWins",
            "bountyRuns",
            "bestRunKills",
            "winsByFaction",
            "winsByWeapon"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "name",
        "gv",
        "gvLifetime",
        "gvByMonth",
        "stats",
        "cosmetics",
        "achievements",
        "progress"
      ],
      "additionalProperties": true
    },
    "ProfileReply": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "token": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        }
      },
      "required": [
        "profile",
        "token",
        "created"
      ],
      "additionalProperties": true
    },
    "ShopReply": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/Profile"
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": true
    },
    "PurchaseBody": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "EquipBody": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "slot",
        "id"
      ],
      "additionalProperties": false
    },
    "LeaderboardReply": {
      "type": "object",
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{2,16}$"
              },
              "gv": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "gv"
            ],
            "additionalProperties": true
          }
        },
        "months": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          }
        },
        "you": {
          "type": "object",
          "properties": {
            "rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "gv": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "rank",
            "gv"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "month",
        "entries",
        "months"
      ],
      "additionalProperties": true
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "need": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "have": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": true
    }
  }
}
