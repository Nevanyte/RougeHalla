+#[tokio::test]
+async fn late_success_receipt_after_takeover_does_not_clear_the_obligation_or_poison_clean_work() {
+    let h = H::new(fulfil()).await;
+    h.seed_foreign().await;
+    let id = "ownreceipt";
+    let host = host_of(id, ZONE);
+    let d = DurabilityConfig {
+        worker_lease: Duration::from_millis(600),
+        reaper_lease: Duration::from_millis(600),
+        backend_op_timeout: Duration::from_secs(20),
+        retention: Duration::ZERO,
+        ..Default::default()
+    };
+    let a = h.worker(ZONE, 20_000, d.clone()).await;
+    let b = h.worker("different.example.com", 20_000, d.clone()).await;
+    h.fake
+        .hold_reply_after_apply(Op::DnsUpsert, Matcher::key(&host));
+    let applied = h
+        .fake
+        .notify_on(Op::DnsUpsert, Matcher::key(&host), Stage::Applied);
+    let rq = request(id, "alice");
+    let (result, ()) = tokio::join!(a.place(&rq), async {
+        tokio::time::timeout(Duration::from_secs(5), applied.wait())
+            .await
+            .unwrap();
+        assert!(h.fake.dns().contains_key(&host));
+        assert_eq!(
+            h.row(id).await.state.attempts[0].dns_upsert,
+            DnsUpsert::InFlight
+        );
+        h.wait_reapable(id).await;
+        assert_eq!(b.reap_abandoned().await, 0);
+        assert!(!h.fake.dns().contains_key(&host));
+        assert_eq!(h.fake.release_all(), 1);
+    });
+    assert!(result.is_err(), "stale success cannot publish");
+    let row = h.row(id).await;
+    assert_eq!(
+        (row.phase, row.state.attempts[0].resolution),
+        (Phase::Active, Resolution::Open)
+    );
+    assert_eq!(row.state.attempts[0].dns_upsert, DnsUpsert::InFlight);
+    assert!(row.state.offer.is_none());
+    assert_eq!(b.purge_retained().await.unwrap(), 0);
+    assert_eq!(b.reap_abandoned().await, 0);
+    h.assert_foreign_untouched();
+    // New unambiguous work still publishes/replays/releases despite the permanent earlier obligation.
+    let c = h.worker(ZONE, 20_000, d).await;
+    let fresh = request("ownclean", "alice");
+    let offer = c.place(&fresh).await.unwrap();
+    assert_eq!(c.place(&fresh).await.unwrap(), offer);
+    c.release_session(&Scope::default(), "ownclean", &offer.placement_id)
+        .await
+        .unwrap();
+    assert_eq!(h.row("ownclean").await.phase, Phase::Released);
+    assert_eq!(h.counts().await.unresolved, 1);
+    assert!(h
+        .fake
+        .trace_of(Op::DnsDelete)
+        .iter()
+        .filter(|m| m.key.contains(id))
+        .all(|m| m.key == host));
+    println!("independent stale receipt effects: {:?}", h.ops(id, ZONE));
+    h.finish().await;
+}
