-                AND NOT jsonb_path_exists(state,
-                    '$.attempts[*] ? (!exists(@.dns_upsert) || @.dns_upsert.type() != "string" || (@.dns_upsert != "idle" && @.dns_upsert != "in_flight" && @.dns_upsert != "ambiguous"))')
-            )
