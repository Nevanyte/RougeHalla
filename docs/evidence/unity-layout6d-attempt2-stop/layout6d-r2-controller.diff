+def scoped_start_capture(args, name, parts):
+    """Capture the start command's frozen raw receipt even when it reports failure."""
+    require(name.startswith("layout6d-r2-") and re.fullmatch(r"[A-Za-z0-9_.-]+", name),
+            "start evidence stem must be layout6d-r2-prefixed")
+    raw_path = EVIDENCE / name
+    invocation_path = raw_path.with_name(name + ".invocation.json")
+    require(not raw_path.exists() and not invocation_path.exists(),
+            "ScopedUnity create-only evidence collision: " + name)
+    command = [sys.executable, str(SCOPED_UNITY), name] + list(parts)
+    proc = subprocess.run(command, cwd=R, capture_output=True)
+    require(raw_path.is_file() and invocation_path.is_file(),
+            "ScopedUnity did not preserve start stdout and invocation metadata")
+    # Parse the preserved stdout regardless of ScopedUnity's nonzero exit. Its
+    # invocation receipt records the actual command exit code and stdout hash.
+    return json.loads(raw_path.read_bytes()), json.loads(invocation_path.read_text())
 
 
