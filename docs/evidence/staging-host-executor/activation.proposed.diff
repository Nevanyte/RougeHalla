+# Nonsecret run inputs only. The installer comes from the Root-pinned image, never from the network here.
+BOOTSTRAP = """#!/bin/bash
+set +x
+set -euo pipefail
+trap 'systemctl poweroff' ERR
+umask 077
+test "$(id -u)" = 0
+test -f /opt/rougehalla/installer/host_executor.py
+test -f /opt/rougehalla/installer/rougehalla-expiry-bootstrap.service
+install -d -m 0700 -o root -g root /etc/rougehalla-bootstrap
+printf '%s' '${BootstrapPlanB64}' | base64 -d > /etc/rougehalla-bootstrap/plan.json
+printf '%s' '${ToolchainReceiptB64}' | base64 -d > /etc/rougehalla-bootstrap/toolchain.json
+printf '%s' '${BoundaryReceiptB64}' | base64 -d > /etc/rougehalla-bootstrap/boundary.json
+install -m 0644 -o root -g root /opt/rougehalla/installer/rougehalla-expiry-bootstrap.service /etc/systemd/system/
+systemctl daemon-reload
+systemctl enable rougehalla-expiry-bootstrap.service
+systemctl start --no-block rougehalla-expiry-bootstrap.service
+"""
 
 
