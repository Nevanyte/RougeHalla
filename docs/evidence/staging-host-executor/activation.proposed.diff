diff -ruN a/tools/staging-full-runtime/installer/rougehalla-expiry-bootstrap.service b/tools/staging-full-runtime/installer/rougehalla-expiry-bootstrap.service
--- a/tools/staging-full-runtime/installer/rougehalla-expiry-bootstrap.service	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/staging-full-runtime/installer/rougehalla-expiry-bootstrap.service	2026-11-09 23:07:42.048139114 +0000
@@ -0,0 +1,21 @@
+# Root-pinned image material. Userdata copies it to /etc/systemd/system, enables and starts it.
+# The host executor is this unit's MAIN process and runs the expiry executor in-process.
+[Unit]
+Description=Independent fail-safe guard for absolute expiry and host installation
+FailureAction=poweroff
+RefuseManualStop=yes
+Wants=network-online.target time-sync.target
+After=network-online.target time-sync.target
+
+[Service]
+Type=oneshot
+User=root
+TimeoutStartSec=120s
+TimeoutStartFailureMode=kill
+KillMode=control-group
+Restart=no
+SuccessExitStatus=
+ExecStart=/usr/bin/python3.12 -E -s /opt/rougehalla/installer/host_executor.py install --plan /etc/rougehalla-bootstrap/plan.json --toolchain-receipt /etc/rougehalla-bootstrap/toolchain.json --boundary-receipt /etc/rougehalla-bootstrap/boundary.json
+
+[Install]
+WantedBy=multi-user.target
