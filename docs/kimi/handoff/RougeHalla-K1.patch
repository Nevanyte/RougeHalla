+    expect(cull.s.progress.get("p0") ?? 0).toBe(0);
+    expect(tour.s.progress.get("p0")).toBe(1);
+    killMobOf(w, "fire", "p0");
+    killMobOf(w, "fire", "p0");
+    expect(cull.s.progress.get("p0")).toBe(2);
+    killMobOf(w, "fire", "p0");
+    killMobOf(w, "fire", "p0");
+    expect(cull.s.progress.get("p0")).toBe(3);
