{
  "name": "raid-br",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @raid/server\" \"npm run dev -w @raid/client\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build:client && npm run build:server && npm run build:cloud-meta",
    "playtest": "node scripts/playtest.mjs",
    "playtest:signin": "node scripts/playtest-signin.mjs",
    "deploy": "npm run cf:deploy --",
    "deploy:status": "wrangler deployments status --config deployment/cloudflare/wrangler.jsonc",
    "deploy:check": "npm run typecheck && npm run build && node --import tsx scripts/deploy-smoke.mjs --compiled",
    "deploy:local": "node scripts/deploy.mjs",
    "deploy:local:status": "node scripts/deploy.mjs status",
    "deploy:local:rollback": "node scripts/deploy.mjs rollback",
    "deploy:local:auto": "node scripts/deploy-watch.mjs install",
    "deploy:local:auto:status": "node scripts/deploy-watch.mjs status",
    "deploy:local:auto:stop": "node scripts/deploy-watch.mjs uninstall",
    "deploy:auto:status": "node scripts/deploy-watch.mjs status",
    "deploy:auto:stop": "node scripts/deploy-watch.mjs uninstall",
    "bots": "npm run bots -w @raid/server",
    "tournament": "npm run tournament -w @raid/server --",
    "harness:factions": "npm run harness:factions -w @raid/server --",
    "build:client": "npm run build -w @raid/client",
    "build:server": "node scripts/build-server.mjs",
    "build:cloud-meta": "node --import tsx scripts/build-cloud-meta.mjs",
    "cf:typecheck": "npm run build:cloud-meta && tsc --noEmit -p deployment/cloudflare/tsconfig.json",
    "cf:test": "vitest run deployment/cloudflare/test",
    "cf:deploy": "npm run build && wrangler deploy --config deployment/cloudflare/wrangler.jsonc",
    "latency": "node scripts/latency-probe.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
