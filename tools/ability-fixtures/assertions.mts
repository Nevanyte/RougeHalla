/** Coverage checks reject accidental non-execution; they never manufacture expected native state. */
import assert from'node:assert/strict';
export function verify(cases:any[],S:any){
 const by=(name:string)=>{const c=cases.find(c=>c.name===name);assert(c,name);return c;};
 const frames=(c:any)=>[c.constructed,c.joined,c.birth,c.initial,...c.timeline.flatMap((a:any)=>a.frames??[a]),c.final];
 const fx=(c:any)=>c.completeNonemptyEventTape.flatMap((t:any)=>t.events.filter((e:any)=>e.type==='fx').map((e:any)=>({time:t.time,...e.fx})));
 const land=(c:any,id?:string)=>fx(c).filter((f:any)=>f.kind==='castLand'&&(!id||f.ability===id));
 const statuses=(c:any,kind:string)=>frames(c).flatMap((f:any)=>[...f.private.players,...f.private.mobs].flatMap((p:any)=>(p.statuses??[]).filter((s:any)=>s.kind===kind).map((s:any)=>({actor:p.id,...s}))));
 const fields=(c:any)=>frames(c).flatMap((f:any)=>f.private.abilities?.fields?.map(([,v]:any)=>v)??[]);
 assert.equal(cases.length,63);assert.equal(new Set(cases.map(c=>c.name)).size,cases.length);
 for(const c of cases){const all=frames(c);for(const t of c.completeNonemptyEventTape)assert(all.some(f=>f.time===t.time&&JSON.stringify(f.events)===JSON.stringify(t.events)),c.name+': nonempty event omitted from full frames');assert.equal(c.ordinarySteps,1+c.input.actions.reduce((n:number,a:any,i:number)=>n+(a.kind==='step'?1:a.kind==='span'||a.kind==='untilOwnMark'?c.timeline.find((t:any)=>t.action===i).executed:0),0));for(const f of all){for(const p of f.private.players)if(p.cast)assert.equal(p.cast.rank,1,'ordinary Wish ability rank');}}
 const lagFrame=frames(by('atomic-reciprocal-freezes-12')).find(f=>f.time===100);assert.equal(lagFrame.private.players.find((p:any)=>p.id==='p0').cast.lagMs,S.MAX_REWIND_MS);assert.equal(lagFrame.private.players.find((p:any)=>p.id==='p1').cast.lagMs,S.TICK_MS);
 const cooldown=by('all-five-normal-cooldowns-and-blaze-stocks');for(const id of S.ABILITY_IDS)assert(land(cooldown,id).length>=2,id+' normal recharge not exercised');assert.deepEqual(cooldown.initial.rng,cooldown.final.rng,'Wish casts draw no new stream values');
 for(const kind of ['stun','silence'])assert.equal(land(by('cast-status-eligibility-'+kind)).length,0);assert.equal(land(by('cast-status-eligibility-root')).length,1);
 assert.equal(land(by('freeze-range-slack-482')).length,1);assert.equal(land(by('freeze-range-slack-482.000001')).length,0);assert.equal(land(by('freeze-wall-los-refusal')).length,0);
 for(const name of ['freeze-after-swarm-fizzles','freeze-moving-target-fizzle'])assert(fx(by(name)).some((f:any)=>f.kind==='castEnd'&&f.reason==='fizzle'));
 assert(fx(by('freeze-interrupt-spends-without-refund')).some((f:any)=>f.kind==='castEnd'&&f.reason==='interrupted'));
 const ranked=by('atomic-landing-rank-reverses-join-and-intake'),intake=frames(ranked).find(f=>f.time===100),due=frames(ranked).find(f=>f.time===350);assert.deepEqual(intake.private.actionRank.map(([id]:any)=>id),['p0','p1','p2']);assert.deepEqual(due.private.actionRank.map(([id]:any)=>id),['p1','p0','p2']);assert.deepEqual(land(ranked).map((f:any)=>f.by),['p1','p0']);
 const batch=by('atomic-due-batch-fizzle-with-surviving-swarm');assert(fx(batch).some((f:any)=>f.reason==='fizzle'));assert.equal(land(batch,'swarm').length,1);
 assert.equal(land(by('atomic-freeze-and-swarm-same-due')).length,2);
 const twins=['p1','absent-actor'].map(n=>by('observer-hidden-absent-twin-'+n).timeline.filter((f:any)=>f.legacyObserver).at(-1));assert.deepEqual(twins[0].legacyObserver,twins[1].legacyObserver);assert.deepEqual(twins[0].private.players.find((p:any)=>p.id==='p0'),twins[1].private.players.find((p:any)=>p.id==='p0'));
 const death=fx(by('pending-freeze-real-sword-death-paylater'));assert(death.findIndex((f:any)=>f.kind==='death')<death.findIndex((f:any)=>f.kind==='castEnd'));assert.equal(land(by('source-born-npc-cannot-originate-wish')).length,0);
 assert.equal(land(by('blaze-zero-time-order-swap-second-cast')).length,1);assert.equal(land(by('blaze-no-direction-and-sealed-pocket')).length,0);assert.equal(land(by('blaze-open-coliseum-gate')).length,1);assert.equal(land(by('blaze-locked-coliseum-gate-no-charge-spend')).length,1);
 for(const name of ['blaze-source-born-npc-return-and-credit',...['fire','plague','frost','sentenced'].map(z=>'blaze-source-born-'+z+'-return-and-credit')]){const c=by(name);assert(c.birth.public.mobs.length>0);assert(fx(c).some((f:any)=>f.kind==='death'&&f.by==='p0'));assert(c.completeNonemptyEventTape.some((t:any)=>t.events.some((e:any)=>e.type==='gv'&&e.id==='p0'&&e.reason==='mob')));assert(statuses(c,'dot').some((s:any)=>s.ability==='blaze'));}
 for(const zone of ['holy','fire','plague','frost','sentenced']){const c=by('full-signature-source-born-'+zone+'-wish-recipients');assert(c.birth.public.mobs.every((m:any)=>m.state.faction===zone));for(const id of ['blaze','freeze','trial'])assert.equal(land(c,id).length,1);}
 const departed=by('blaze-trail-outlives-removed-owner-to-lethal');assert(fx(departed).some((f:any)=>f.kind==='death'&&f.id==='p1'&&f.by===null),'departed owner is absent from death FX');assert(fx(departed).some((f:any)=>f.kind==='hit'&&f.by==='p0'&&f.ability==='blaze'),'immutable delayed burn attribution');assert(departed.completeNonemptyEventTape.some((t:any)=>t.events.some((e:any)=>e.type==='resolved'&&e.id==='p1'&&e.result.killedBy==='name0')),'result retains source name');assert.equal(by('blaze-trail-outlives-removed-owner-to-lethal').final.public.players.some((p:any)=>p.id==='p0'),false);
 for(const name of ['laststand-overkill-and-natural-payback','laststand-teleport-payback-without-cooldown-refund','laststand-antiheal-common-healing'])assert(fx(by(name)).some((f:any)=>f.kind==='heal'&&f.amount>0));
 for(const name of ['laststand-run-end-does-not-pay','laststand-mia-does-not-pay'])assert.equal(fx(by(name)).filter((f:any)=>f.kind==='heal').length,0);
 const heal=(name:string)=>fx(by(name)).find((f:any)=>f.kind==='heal').amount;assert.equal(heal('laststand-antiheal-common-healing'),heal('laststand-overkill-and-natural-payback')*0.5);
 assert(statuses(by('trial-inclusive-edge-then-ordinary-exit'),'stun').some((s:any)=>s.ability==='trial'&&s.until-s.startedAt===S.TRIAL_EXIT_STUN_MS));assert(fields(by('trial-gallows-card-exit')).some((f:any)=>f.kind==='zone'&&f.endsAt-f.startedAt>S.TRIAL_MS));assert(fields(by('trial-own-convicted-mark-from-real-weapon-hits')).some((f:any)=>f.r===S.TRIAL_CONVICTED_RADIUS));assert(fields(by('trial-other-owner-convicted-is-not-own-mark')).some((f:any)=>f.r===S.TRIAL_RADIUS));
 const replacement=by('training-swarm-real-five-second-recast-replacement');assert.equal(land(replacement,'swarm').length,2);assert.equal(new Set(fields(replacement).filter((f:any)=>f.kind==='cloud').map((f:any)=>f.id)).size,2);
}
