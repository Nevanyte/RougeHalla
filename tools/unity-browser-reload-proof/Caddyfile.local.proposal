# SOURCE-ONLY PROPOSAL, NOT RUN. Root supplies a coherent immutable Web resource root.
# Derived from the admitted staging route ordering; no deployment/TLS/route acceptance follows.
{
    admin off
    servers {
        protocols h1 h2
    }
}

http://127.0.0.1:8888 {
    route {
        @source path /ws /info /ping /healthz /api /api/* /readyz
        handle @source {
            reverse_proxy 127.0.0.1:7777
        }
        @training path /training/ws
        handle @training {
            rewrite * /ws
            reverse_proxy 127.0.0.1:7779
        }
        @trainingHealth path /training/info /training/ping /training/healthz
        handle @trainingHealth {
            uri strip_prefix /training
            reverse_proxy 127.0.0.1:7779
        }
        @private path /control /control/* /probe /training/api /training/api/* /training/readyz /training/control /training/control/* /training/probe
        handle @private {
            respond 404
        }
        handle {
            root * {$RH_BROWSER_PROOF_WEB_ROOT}
            header {
                X-Content-Type-Options nosniff
                Cache-Control no-cache
            }
            @data path /Build/*.data
            header @data Content-Type application/octet-stream
            file_server {
                precompressed gzip
            }
        }
    }
}
