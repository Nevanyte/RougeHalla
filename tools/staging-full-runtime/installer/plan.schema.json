{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Offline installer candidate, not deployment admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "account",
    "region",
    "domain",
    "run_id",
    "prepared_at",
    "host_expires_at",
    "mode",
    "previous_run_id",
    "volume",
    "artifact",
    "backup",
    "toolchain_receipt_sha256",
    "boundary_receipt_sha256",
    "backup_seconds"
  ],
  "properties": {
    "format": {
      "const": "rh-staging-installer-candidate/1"
    },
    "account": {
      "const": "048226733033"
    },
    "region": {
      "const": "ca-west-1"
    },
    "domain": {
      "const": "rougehalla.com"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}t[0-9]{6}z-[0-9a-f]{6}$"
    },
    "prepared_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "host_expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "mode": {
      "enum": [
        "fresh",
        "restore"
      ]
    },
    "previous_run_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{8}t[0-9]{6}z-[0-9a-f]{6}$"
        }
      ]
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uuid",
        "filesystem",
        "mountpoint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^vol-[0-9a-f]{17}$"
        },
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "filesystem": {
          "const": "ext4"
        },
        "mountpoint": {
          "const": "/srv/rougehalla-data"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "key",
        "version_id",
        "bytes",
        "sha256"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "key": {
          "type": "string",
          "pattern": "^runs/[0-9]{8}t[0-9]{6}z-[0-9a-f]{6}/public-bundle[.]tar$"
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "key",
        "max_bytes"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "key": {
          "type": "string",
          "pattern": "^runs/[0-9]{8}t[0-9]{6}z-[0-9a-f]{6}/cold-backup[.]age$"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    },
    "toolchain_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundary_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backup_seconds": {
      "type": "integer",
      "minimum": 1
    }
  }
}
