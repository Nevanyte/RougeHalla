import assert from 'node:assert/strict';
import {decode} from './verify.mjs';
export function reachedChecks(cases:any[]){const done:any[]=[];
 const c=(id:string)=>{const v=cases.find(c=>c.id===id);assert(v,id);return v;},acts=(id:string)=>c(id).operations.filter((o:any)=>o.method==='act'),r=(o:any)=>decode(o.result,true),st=(o:any)=>decode(o.stats,true),cb=(o:any)=>decode(o.callbacks,true);
 const check=(id:string,fn:()=>void)=>{fn();done.push(id);};
 check('knowledge draw once across first idle/module and all9 goals',()=>{const a=acts('dispatch-nine-and-knowledge-once');assert.equal(a[0].drawCounts.decide,1);assert.equal(a[1].drawCounts.decide,1);assert.equal(new Set(a.map((o:any)=>decode(o.declaration).goal.kind)).size,9);});
 check('actual camp mate near and same camp retain wand lock; returning exclusion',()=>{for(const id of ['mate-near','mate-radius-at','mate-same-camp-far-real-history']){assert.equal(r(acts(id)[0]).status.why,'locked: the server is fighting');assert.equal(r(acts(id)[0]).attacking,true);}assert.equal(r(acts('mate-radius-above')[0]).intents[0].target,'mob1');assert.equal(r(acts('mate-returning-history')[1]).status.why,'locking');const m=decode(acts('mate-returning-history')[1].memory,true).mobs.get('mate');assert(m.returning);});
 check('swap cooldown no draw then redraw; real knowledge callbacks',()=>{const a=acts('swap-player-cooldown');assert(r(a[0]).intents.some((i:any)=>i.kind==='swap'));assert(!r(a[1]).intents.some((i:any)=>i.kind==='swap'));assert.equal(a[1].drawCounts.decide,a[0].drawCounts.decide);assert.equal(a[2].drawCounts.decide,a[1].drawCounts.decide+1);assert(cb(a[0]).some((x:any)=>x.name==='knowledge.weaponEdge'));});
 check('progress strict10000 and path replan strict400 three failures',()=>{const a=acts('fight-progress-timeout');assert.equal(r(a.at(-2)).status.state,'running');assert.equal(r(a.at(-1)).status.why,'no progress in 10 s');const p=acts('fight-plan-three-failures');assert.equal(r(p.at(-1)).status.why,'no path to the target');assert.equal(cb(p[1]).filter((x:any)=>x.name==='paths.path').length,0);assert.equal(cb(p[2]).filter((x:any)=>x.name==='paths.path').length,1);});
 check('real Orb launch/wait/applied timed lock and reset retains cycles',()=>{const a=c('orb-launch-reset-and-timeouts').operations.filter((o:any)=>o.method==='step');assert.equal(r(a[0]),null);assert.equal(r(a[1]).kind,'move');assert.equal(r(a[2]),'wait');assert.equal(r(a[3]).timing.kind,'timed');assert.equal(st(a.at(-1)).cycles,1);assert.equal(st(acts('tactics-real-orb-cycle')[1]).stats.kiteCycles,1);});
 check('real shared world dodge and fight hold; world pickup channel preserved',()=>{const a=acts('world-fight-shared-dodge-hold');assert.equal(r(a[0]).status.state,'blocked');assert.equal(st(a[0]).stats.dodges,1);assert.equal(r(a[1]).status.why,'a sidestep is on its way');const p=acts('world-reflex-preserves-pickup');assert.deepEqual(r(p[0]).intents.map((i:any)=>i.kind),['pickup','move']);assert.deepEqual(r(p[1]).intents.map((i:any)=>i.kind),['pickup']);});
 check('real juke and real Memory feint read',()=>{assert.equal(st(acts('fight-world-shared-juke-hold')[0]).stats.jukes,1);const o=c('reflex-real-feint-history').operations.at(-1);assert.equal(decode(o.memory,true).fighters.get('foe').feints,1);assert.equal(r(o),null);assert.equal(o.drawCounts.decide,1);});
 check('flee first blocked then running; reset increments; until boundary done',()=>{const a=acts('flee-retention-reset-until');assert.equal(r(a[0]).status.state,'blocked');assert.equal(r(a[1]).status.why,'fleeing');assert.equal(st(a.at(-2)).stats.retreats,2);assert.equal(r(a.at(-1)).status.state,'done');assert.equal(r(acts('flee-corner-empty')[0]).status.state,'failed');assert.equal(r(acts('flee-corner-player')[0]).status.why,'cornered: fighting on');});
 check('loot150 settle400 retry event-once fail2 final latch and stale reset',()=>{const a=acts('loot-settle-retry-event-once-final');assert.equal(r(a[0]).status.why,'settling');assert.equal(r(a[1]).intents.length,0);assert.equal(r(a[2]).intents[0].kind,'pickup');assert.equal(r(a[3]).intents.length,0);assert.equal(r(a[4]).intents[0].kind,'pickup');assert.equal(r(a[5]).status.why,'taking');assert.equal(r(a[6]).status.why,'refused');assert.equal(r(a[7]).status.why,'refused');assert.equal(r(a[8]).intents[0].kind,'pickup');assert.equal(r(acts('loot-memory-skipped')[1]).status.why,'skipped');});
 check('real null service failure and explicit test-service empty throw distinct',()=>{assert.equal(r(acts('loot-path-null')[0]).status.why,'unreachable');const o=acts('loot-path-empty')[0];assert.equal(o.thrown.name,'TypeError');assert.equal(r(o),undefined);assert(cb(o).some((x:any)=>x.name==='paths.path'&&x.result.length===0));});
 check('crowded24 step draws cache then stale reselection',()=>{const a=acts('hold-crowded-spot-stale');assert.equal(a[0].drawCounts.decide,26);assert.equal(a[1].drawCounts.decide,26);assert.equal(a[2].drawCounts.decide,51);assert.deepEqual(r(a[0]).intents[0].to,r(a[1]).intents[0].to);assert.notDeepEqual(r(a[0]).intents[0].to,r(a[2]).intents[0].to);});
 check('all stats aliases agree and unused motor/lapse stay zero',()=>{for(const c of cases)for(const o of c.operations){assert.equal(o.drawCounts.motor,0);assert.equal(o.drawCounts.lapse,0);const s=st(o);if(s.stats)assert.deepEqual(s.stats,s.getStats);}});

 check('real detour versus actual budget fallback; no constant path answers',()=>{const a=acts('loot-real-detour')[0],b=acts('loot-budgeted-path-fallback')[0];assert.notDeepEqual(r(a).intents[0].to,{x:1700,y:760});assert(cb(a).some((x:any)=>x.name==='paths.path'&&Array.isArray(x.result)&&x.result.length>0));assert(cb(b).some((x:any)=>x.name==='paths.path'&&x.result===null));assert(cb(b).some((x:any)=>x.name==='paths.walk'&&x.result.exact===false));});
 check('reflex opposite heading reached after denied first; dodge beats juke',()=>{const a=c('reflex-extra-second-heading').operations.find((o:any)=>o.method==='check');const paths=cb(a).filter((x:any)=>x.name==='paths.clear');assert.equal(paths.length,2);assert.equal(paths[0].result,false);assert.equal(paths[1].result,true);assert.equal(r(a).kind,'dodge');const b=c('reflex-dodge-outranks-juke').operations.at(-1);assert.equal(st(b).dodges,1);assert.equal(st(b).jukes,0);});
 check('exact seeded swap clock and rounded hold/stale boundary',()=>{const a=acts('swap-exact-seeded-cooldown');assert(!r(a[1]).intents.some((i:any)=>i.kind==='swap'));assert(r(a[2]).intents.some((i:any)=>i.kind==='swap'));const h=acts('hold-key-rounded-and-stale-boundary');assert.equal(r(h[0]).intents.length,1);assert.equal(r(h[1]).intents.length,0);assert.equal(r(h[2]).intents.length,1);assert.equal(r(h[3]).intents.length,0);assert.equal(r(h[4]).intents.length,1);});

 check('Retreat arrival48 isolated from safe retained threat set',()=>{const p=c('retreat-threat-invalidates-arrival').operations.filter((o:any)=>o.method==='point');assert.deepEqual(r(p[1]),r(p[2]));assert.equal(cb(p[2]).filter((x:any)=>x.name==='paths.clear').length,0);assert.equal(cb(p[3]).filter((x:any)=>x.name==='paths.clear').length,32);assert.notDeepEqual(r(p[2]),r(p[3]));});
 return done;
}
