import assert from'node:assert/strict';import{spawnSync}from'node:child_process';
export async function verifyControls(cases:any[],E:any){const specs=[{name:'real-block-pending-best-pocket-tank-wish',actions:2,span:5},{name:'real-conversions-defense-speed-caps',actions:2,span:5},{name:'deferred-real-spike-reset-teleport',actions:4}];
 function control(input:any){const child=spawnSync(process.execPath,['--import','tsx','tools/card-runtime-fixtures/control.mts'],{input:JSON.stringify(input),encoding:'utf8',env:{...process.env,RH_CARD_NO_INSPECTOR:'1'},maxBuffer:100*1024*1024});assert.equal(child.status,0,child.stderr);return JSON.parse(child.stdout);}
 const controls=specs.map(spec=>{const input=structuredClone(cases.find(c=>c.name===spec.name));input.actions=input.actions.slice(0,spec.actions);if(spec.span)input.actions[1].count=spec.span;input.captureEveryTick=true;return{input,control:control(input)};});
 await E.prepareInspection();function strip(v:any):any{if(Array.isArray(v))return v.map(strip);if(v&&typeof v==='object')return Object.fromEntries(Object.entries(v).filter(([k])=>k!=='privateOracle'&&k!=='reason').map(([k,x])=>[k,strip(x)]));return v;}
 function prefix(input:any,n:number){const out=structuredClone(input);out.actions=[];let left=n-1;for(const a of input.actions){if(left===0)break;if(a.kind==='step'){out.actions.push(a);left--;}else if(a.kind==='span'){const count=Math.min(left,a.count);out.actions.push({...a,count});left-=count;}else out.actions.push(a);}assert.equal(left,0);return out;}
 return controls.map(({input,control:original})=>{const observed=E.run(input);assert.deepEqual(strip(observed),strip(original.result),'complete state/events/hook/input/RNG noninterference');assert.deepEqual(E.lastOracle(),original.postTracePrivateOracle,'all final actual lexical facts');const frames=[observed.initial,...observed.timeline.flatMap((a:any)=>a.frames??[a])],prefixChecks=[];for(let n=1;n<=observed.ordinarySteps;n++){const before=frames.find((f:any)=>f.tick===n);assert(before);const c=n===observed.ordinarySteps?original:control(prefix(input,n));assert.deepEqual(before.private.privateOracle,c.postTracePrivateOracle,'all actual private oracle facts at ordinary tick '+n);for(const[key,value]of Object.entries(c.privateOracleRecords))assert.equal(E.sha(JSON.stringify(value)),key);prefixChecks.push({ordinarySteps:n,postTraceOracleSha256:E.sha(JSON.stringify(c.postTracePrivateOracle))});}return{input,control:'fresh process has no inspector until its ordinary prefix ends; post-trace WeakMap.get extraction only',comparison:'complete raw/public state, rt.cards, events, non-oracle hooks, input admission and RNG every tick; complete private lexical facts independently after every ordinary prefix; transient within-hook oracle is private diagnostics',timelineSha256:E.sha(JSON.stringify(strip(observed))),finalPrivateOracle:E.lastOracle(),prefixChecks};});
}
