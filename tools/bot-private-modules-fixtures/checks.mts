 ops=c('registry-order-and-context').operations.filter((o:any)=>o.method==='registry.enabled');check('defaults/replacement stable/reset/redefaults','registry-order-and-context',ops,()=>{assert.deepEqual(r(ops[0]).map((x:any)=>x.id),['wishes','planning','chests','hazards']);assert.deepEqual(r(ops[1]).map((x:any)=>x.id),['wishes','planning','chests','hazards','extra']);assert.equal(r(ops[3]).length,0);});
 for(const id of ['chests-two-configs','planning-two-configs','wish-two-configs','hazard-two-configs']){ops=c(id).operations.filter((o:any)=>o.method==='hook');check('interleaved two real configs '+id,id,ops,()=>{assert(Object.hasOwn(ops[0].contexts,'a')&&Object.hasOwn(ops[0].contexts,'b'));assert.deepEqual(Object.keys(decode(c(id).configs)),['a','b']);assert.notDeepEqual(decode(ops[0].contexts.a.memory),decode(ops[0].contexts.b.memory));});}

 ops=hooks('chests-two-configs','intents');check('chest ask expiry belongs to exact cfg object','chests-two-configs',ops,()=>assert.deepEqual(ops.map((o:any)=>r(o).map((i:any)=>i.msg.pick)),[[0],[0],[],[1]]));
