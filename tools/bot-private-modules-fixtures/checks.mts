 ops=hooks('planning-forced-lapse-and-bias','intents');check('reached lapse and nonfinite bias sanitizer','planning-forced-lapse-and-bias',ops,()=>{assert.equal(ops[1].contexts.a.drawCounts.lapse,2);assert(cb(ops[1]).some((x:any)=>x.name==='learned.bias'&&Number.isNaN(x.result)));assert.equal(r(ops[1])[0].kind,'plan');});
 ops=hooks('wish-availability-easy-1','intents');check('Easy forget then new availability remember, only edge draws','wish-availability-easy-1',ops,()=>{assert.equal(r(ops[0]).length,0);assert.equal(r(ops[5])[0].kind,'cast');assert.equal(ops[5].contexts.a.drawCounts.decide,2);assert.equal(ops[4].contexts.a.drawCounts.decide,1);});
 ops=hooks('wish-slip-pending-expiry','act');check('pending2500 expiry and retained from/leg after hidden','wish-slip-pending-expiry',ops,()=>{assert.equal(r(ops[0]).status.state,'running');assert.equal(r(ops[1]).status.state,'done');assert.equal(r(ops[2]).status.state,'running');});
