 ops=hooks('chests-crowd-life-nearer','act');check('explicit another chest nearer termination','chests-crowd-life-nearer',ops,()=>assert.equal(r(ops[0]).status.why,'another chest is nearer'));
 ops=hunt('hunter-distinct-clocks');check('independent monotonic cache/server clocks are not aliases','hunter-distinct-clocks',ops,()=>{assert.deepEqual(ops.map((o:any)=>r(o).kind),['walk','walk','walk','none']);assert.deepEqual(ops.map((o:any)=>cb(o).filter((x:any)=>x.name==='hunter.walk').length),[1,0,1,0]);});
 ops=hooks('planning-no-deal','intents');check('phase reentry follow-up never resets ready latch','planning-no-deal',ops,()=>{assert.equal(r(ops[2])[0].msg.ready,true);assert.equal(r(ops.at(-1)).length,0);assert.equal(d(c('planning-no-deal').operations.filter((o:any)=>o.method==='observe').at(-1)).input.now,104000);});
 for(const c of cases){const clocks=new Map();let hn=-Infinity,hs=-Infinity;for(const o of c.operations){const x=d(o);if(x.method==='observe'){assert(x.input.now>=(clocks.get(x.cfg)??-Infinity),c.id+': chronological Memory');clocks.set(x.cfg,x.input.now);}if(x.method==='hunter.decide'){assert(x.input.now>=hn&&x.input.serverTime>=hs,c.id+': independent chronological Hunter clocks');hn=x.input.now;hs=x.input.serverTime;}}}
