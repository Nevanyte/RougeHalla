 ops=hooks('wish-easy-offense-filter','intents');check('remembered Easy still declines offensive-only def','wish-easy-offense-filter',ops,()=>{const draws=c('wish-easy-offense-filter').operations.flatMap(cb).filter((x:any)=>x.kind==='rng'&&x.stream==='decide');assert.equal(draws.length,1);assert(draws[0].value<.6);assert.equal(r(ops[0]).length,0);});
