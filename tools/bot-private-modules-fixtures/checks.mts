import assert from'node:assert/strict';import{decode}from'./verify.mjs';
export function reachedChecks(cases:any[]){const ledger:any[]=[];const c=(id:string)=>{const x=cases.find(c=>c.id===id);assert(x,id);return x;},d=(o:any)=>decode(o.declaration),r=(o:any)=>decode(o.result,true),cb=(o:any)=>decode(o.callbacks,true),hooks=(id:string,name:string)=>c(id).operations.filter((o:any)=>o.method==='hook'&&d(o).name===name),hunt=(id:string)=>c(id).operations.filter((o:any)=>o.method==='hunter.decide');
 const check=(name:string,id:string,ops:any[],f:()=>any)=>{f();ledger.push({name,case:id,operations:ops.map(o=>c(id).operations.indexOf(o)),evidence:ops.map(o=>({method:o.method,...(o.method==='hook'?{hook:d(o).name}:{}),result:o.result,drawCounts:Object.fromEntries(Object.entries<any>(o.contexts).map(([k,v])=>[k,v.drawCounts])),callbacks:o.callbacks}))});};
 // Per-case actual reach inventory is factual, separate from intended covers; detailed assertions below bind semantic claims.
 const inventory=cases.map(c=>({case:c.id,operations:c.operations.length,methods:[...new Set(c.operations.map((o:any)=>o.method))],hooks:[...new Set(c.operations.filter((o:any)=>o.method==='hook').map((o:any)=>d(o).module+'.'+d(o).name))],callbackNames:[...new Set(c.operations.flatMap((o:any)=>cb(o)).filter((x:any)=>x.kind==='callback').map((x:any)=>x.name))],intentKinds:[...new Set(c.operations.flatMap((o:any)=>{const x=r(o);return Array.isArray(x)?x.filter(i=>i?.kind).map(i=>i.kind):x?.intents?.map((i:any)=>i.kind)??[];}))]}));
 let ops=c('choice-catalog-0').operations;check('all80 source cardScore/alias calls with base-owned conditionals','choice-catalog-0',ops,()=>{assert.equal(ops.length,160);for(let i=0;i<ops.length;i+=2)assert.deepEqual(r(ops[i]),r(ops[i+1]));assert(ops.some((o:any)=>d(o).args.id==='spellsword'&&Number.isFinite(r(o))));});
 ops=c('choice-costs').operations;check('actual catalog both costing and noncosting effects','choice-costs',ops,()=>{assert.equal(ops.length,80);assert(ops.some((o:any)=>r(o)===true));assert(ops.some((o:any)=>r(o)===false));});
 ops=c('choice-special-and-options').operations.filter((o:any)=>d(o).name==='chooseOption');check('stable ties/free/taken/empty/all-refused','choice-special-and-options',ops,()=>assert.deepEqual(ops.map(r),[-1,0,1,-1,-1,0]));
 for(const id of ['hunter-hold-149-10000','hunter-hold-150-10000']){ops=hunt(id);check('strict birth hold '+id,id,ops,()=>assert.equal(r(ops[0]).kind,id.includes('149')?'none':'pick'));}
 for(const id of ['hunter-cache-direct','hunter-cache-radius-denial']){ops=hunt(id);check('nearest3 and cached callback silence until250 '+id,id,ops,()=>{assert.equal(cb(ops[0]).filter((x:any)=>x.name==='hunter.walk').length,3);assert.equal(cb(ops[1]).filter((x:any)=>x.name==='hunter.walk').length,0);assert.equal(cb(ops[2]).filter((x:any)=>x.name==='hunter.walk').length,3);});}
 ops=hunt('hunter-stall-interrupt');check('persistent walked-only capped stall/giveup/stats/log','hunter-stall-interrupt',ops,()=>{assert.equal(r(ops[3]).kind,'none');assert.equal(r(ops[4]).kind,'walk');assert(ops.some((o:any)=>decode(o.hunter.stats).gaveUp===1&&cb(o).some((x:any)=>x.name==='hunter.log'&&x.args[0].startsWith('giving up'))));assert.equal(r(c('hunter-stall-interrupt').operations.find((o:any)=>o.method==='hunter.tried')),true);});
