 ops=hooks('chests-boost-count-dedup-max','intents');check('count once/cap3/max merge distinguishes hidden state','chests-boost-count-dedup-max',ops,()=>assert.deepEqual(ops.map((o:any)=>r(o)[0].msg.pick),[0,0,0,0,1]));
