 ops=hooks('chests-awake-history','goals');check('Memory home history genuinely earns awake fight guard','chests-awake-history',ops,()=>{assert.equal(r(ops[0]).length,1);assert.equal(r(ops[1]).length,0);assert.equal(decode(ops[1].contexts.a.memory).mobs.get('awake').awake,true);});
 ops=hooks('planning-exact-resend-settle','intents');check('event schedule/read/resend560/three asks/settle exact','planning-exact-resend-settle',ops,()=>{assert.deepEqual(ops.map((o:any)=>r(o).map((i:any)=>({...i.msg}))),[[],[],[{spawn:0}],[],[{spawn:0}],[{spawn:0}],[],[],[{ready:true}]]);assert.equal(ops[2].contexts.a.drawCounts.lapse,1);assert.equal(ops[8].contexts.a.drawCounts.lapse,3);});
