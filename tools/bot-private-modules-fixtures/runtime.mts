import{join}from'node:path';import{pathToFileURL}from'node:url';
export const ROOT=process.env.RH_BOT_MODULES_SOURCE_ROOT??'/repo';
const source=(p:string)=>import(pathToFileURL(join(ROOT,p)).href);
export const shared=await source('packages/shared/src/index.ts');
export const types=await source('packages/server/src/bots/brain/types.ts');
export const memory=await source('packages/server/src/bots/brain/memory.ts');
export const knowledge=await source('packages/server/src/bots/brain/knowledge.ts');
export const services=await source('packages/server/src/bots/brain/services.ts');
export const hunt=await source('packages/server/src/bots/chestHunt.ts');
export const policy=await source('packages/server/src/bots/abilityPolicy.ts');
export const chests=await source('packages/server/src/bots/brain/modules/chests.ts');
export const planning=await source('packages/server/src/bots/brain/modules/planning.ts');
export const wishes=await source('packages/server/src/bots/brain/modules/wishes.ts');
export const hazards=await source('packages/server/src/bots/brain/modules/hazards.ts');
export const registry=await source('packages/server/src/bots/brain/modules/index.ts');
export const mapgen=await source('packages/shared/src/mapgen.ts');
export const mapWire=await source('packages/shared/src/mapWire.ts');
export const modules:any={wishes:wishes.wishesModule,planning:planning.planningModule,chests:chests.chestsModule,hazards:hazards.hazardsModule};
export const resetRegistry=()=>{registry.resetModules();for(const m of Object.values(modules))registry.registerModule(m);};
