{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StackAndFleetInTheTwoStagingRegionsOnly",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:DeleteStack"
      ],
      "Resource": "arn:aws:cloudformation:*:961470857356:stack/rougehalla-infra-*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "ca-central-1",
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "TemplateValidationHasNoResource",
      "Effect": "Allow",
      "Action": "cloudformation:ValidateTemplate",
      "Resource": "*"
    },
    {
      "Sid": "CreateTaggedGameLiftResources",
      "Effect": "Allow",
      "Action": [
        "gamelift:CreateContainerFleet",
        "gamelift:CreateContainerGroupDefinition"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "ca-central-1"
          ],
          "aws:RequestTag/Project": "rougehalla-infra"
        }
      }
    },
    {
      "Sid": "ChangeOnlyTaggedGameLiftResources",
      "Effect": "Allow",
      "Action": [
        "gamelift:UpdateContainerFleet",
        "gamelift:DeleteContainerFleet",
        "gamelift:UpdateContainerGroupDefinition",
        "gamelift:DeleteContainerGroupDefinition",
        "gamelift:PutScalingPolicy",
        "gamelift:DeleteScalingPolicy",
        "gamelift:UpdateFleetCapacity",
        "gamelift:StopFleetActions",
        "gamelift:StartFleetActions",
        "gamelift:TagResource",
        "gamelift:UntagResource"
      ],
      "Resource": [
        "arn:aws:gamelift:*:961470857356:containerfleet/*",
        "arn:aws:gamelift:*:961470857356:containergroupdefinition/rougehalla-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "ca-central-1"
          ],
          "aws:ResourceTag/Project": "rougehalla-infra"
        }
      }
    },
    {
      "Sid": "ReadContainerResources",
      "Effect": "Allow",
      "Action": [
        "gamelift:DescribeContainerFleet",
        "gamelift:DescribeContainerGroupDefinition",
        "gamelift:ListContainerGroupDefinitionVersions",
        "gamelift:DescribeFleetDeployment"
      ],
      "Resource": [
        "arn:aws:gamelift:*:961470857356:containerfleet/*",
        "arn:aws:gamelift:*:961470857356:containergroupdefinition/rougehalla-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "ca-central-1"
          ]
        }
      }
    },
    {
      "Sid": "ReadGameLiftInventory",
      "Effect": "Allow",
      "Action": [
        "gamelift:ListContainerFleets",
        "gamelift:ListContainerGroupDefinitions",
        "gamelift:DescribeFleetCapacity",
        "gamelift:ListFleetDeployments",
        "gamelift:DescribeFleetEvents",
        "gamelift:DescribeFleetLocationCapacity",
        "gamelift:DescribeScalingPolicies",
        "gamelift:DescribeGameSessions",
        "gamelift:ListTagsForResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "ca-central-1"
          ]
        }
      }
    },
    {
      "Sid": "ImageRegistryForTheExperimentPrefixOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages",
        "ecr:PutLifecyclePolicy",
        "ecr:TagResource",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchDeleteImage"
      ],
      "Resource": "arn:aws:ecr:*:961470857356:repository/rougehalla-infra/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "ca-central-1"
          ]
        }
      }
    },
    {
      "Sid": "EcrAuthorizationTokenHasNoResource",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "AlarmsTopicsAndLogsForTheExperimentPrefixOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:Subscribe",
        "sns:TagResource",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": [
        "arn:aws:cloudwatch:*:961470857356:alarm:rougehalla-infra-*",
        "arn:aws:logs:*:961470857356:log-group:gamelift-rougehalla-infra/*",
        "arn:aws:sns:*:961470857356:rougehalla-infra-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "ca-central-1"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyInventoryForVerifyNoBillable",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:ListDashboards",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "logs:DescribeLogGroups",
        "sns:ListTopics",
        "tag:GetResources",
        "ec2:DescribeInstances",
        "ce:GetCostAndUsage",
        "sts:GetCallerIdentity",
        "cloudformation:ListStacks",
        "iam:ListRoles",
        "iam:ListPolicies",
        "gamelift:DescribeFleetLocationAttributes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FleetRoleLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies"
      ],
      "Resource": "arn:aws:iam::961470857356:role/rougehalla-infra-*-fleet-*"
    },
    {
      "Sid": "OnlyTheGameLiftManagedPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::961470857356:role/rougehalla-infra-*-fleet-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/GameLiftContainerFleetPolicy"
        }
      }
    },
    {
      "Sid": "PassFleetRoleOnlyToGameLift",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::961470857356:role/rougehalla-infra-*-fleet-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "gamelift.amazonaws.com"
        }
      }
    },
    {
      "Sid": "BudgetAndItsActionInUsEast1",
      "Effect": "Allow",
      "Action": [
        "budgets:CreateBudgetAction",
        "budgets:DeleteBudgetAction",
        "budgets:DescribeBudgetAction",
        "budgets:ModifyBudget",
        "budgets:ViewBudget"
      ],
      "Resource": "arn:aws:budgets::961470857356:budget/rougehalla-infra-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "RemoveSubscriptionRequiresWildcard",
      "Effect": "Allow",
      "Action": "sns:Unsubscribe",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "ca-central-1"
          ]
        }
      }
    }
  ]
}
